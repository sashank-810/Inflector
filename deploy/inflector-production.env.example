# Names-only operator inventory. Systemd does not load this aggregate file.
# Populate the least-privilege service files from deploy/env/ instead.
# Never commit real credentials.
INFLECTOR_PRODUCTION_DATABASE_URL=
DATABASE_URL=

INFLECTOR_PRODUCTION_RAW_ROOT=/srv/inflector/archive/nse
RAW_ARCHIVE_ROOT=/srv/inflector/archive/nse
INFLECTOR_GDELT_RAW_ROOT=/srv/inflector/archive/gdelt

INFLECTOR_NSE_LICENSE_CLASS=
INFLECTOR_GDELT_LICENSE_CLASS=

INFLECTOR_MODEL_FAMILY=inflector_v1
INFLECTOR_RESEARCH_PROFILE=config/research/production_research_v4.json
INFLECTOR_OPERATIONS_PROFILE=config/operations/production_operations_v6.json
INFLECTOR_SYMBOLS_FILE=/srv/inflector/config/production-symbols.txt

INFLECTOR_MODEL_SEMANTIC_VERSION=1.0.0
INFLECTOR_DEPLOYED_GIT_SHA=
# Operator-required: use the reviewed activation instant; no repository default exists.
INFLECTOR_MODEL_EFFECTIVE_FROM=

CORS_ORIGINS=
NEXT_PUBLIC_API_BASE_URL=
INFLECTOR_PUBLIC_API_HOST=
INFLECTOR_PUBLIC_WEB_HOST=

INFLECTOR_TELEGRAM_BOT_TOKEN=
INFLECTOR_TELEGRAM_CHAT_ID=
INFLECTOR_ALLOW_LIVE_TELEGRAM_SMOKE=0
