# Local PostgreSQL (started by `docker compose up postgres`)
POSTGRES_DB=inflector
POSTGRES_USER=inflector
POSTGRES_PASSWORD=inflector
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://inflector:inflector@localhost:5432/inflector
RAW_ARCHIVE_ROOT=var/raw

# Production NSE market, financial, and catalyst ingestion (never use synthetic data)
INFLECTOR_PRODUCTION_DATABASE_URL=
INFLECTOR_PRODUCTION_RAW_ROOT=
INFLECTOR_NSE_LICENSE_CLASS=
INFLECTOR_GDELT_RAW_ROOT=
INFLECTOR_GDELT_LICENSE_CLASS=

# Production operations (safe examples only; target symbols remain an explicit local file)
INFLECTOR_MODEL_FAMILY=inflector_v1
INFLECTOR_RESEARCH_PROFILE=config/research/production_research_v2.json
INFLECTOR_OPERATIONS_PROFILE=config/operations/production_operations_v2.json
INFLECTOR_SYMBOLS_FILE=

# FastAPI
CORS_ORIGINS=http://localhost:3000

# Next.js (copy this file to apps/web/.env.local when developing the web app)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
