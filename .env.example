# Local PostgreSQL (started by `docker compose up postgres`)
POSTGRES_DB=inflector
POSTGRES_USER=inflector
POSTGRES_PASSWORD=inflector
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://inflector:inflector@localhost:5432/inflector

# FastAPI
CORS_ORIGINS=http://localhost:3000

# Next.js (copy this file to apps/web/.env.local when developing the web app)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

